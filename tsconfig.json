{
    "compilerOptions": {
      "target": "ES2022",
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "rootDir": "./src",
      "outDir": "./dist",
      "types": ["node"],
      "strict": true,
      "noUncheckedIndexedAccess": true,
      "skipLibCheck": true
    },
    "include": ["src/**/*"]
  }
  